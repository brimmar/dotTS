{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/resources/*": ["src/public-props.ts"],
      "@/core/context": ["src/public-props.ts"],
      "@/core/app": ["src/public-props.ts"]
    }
  },
  "include": ["src/public.ts"]
}
