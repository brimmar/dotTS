{
  "name": "dotts",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome lint --apply .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "build": "bun build ./src/index.ts --compile --outfile dotts",
    "ci": "bun run test && bun run lint && bun run type-check && bun run build"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.6.0",
    "biome": "^0.3.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "console-log-colors": "^0.5.0",
    "effect": "^3.21.2",
    "mustache": "^4.2.0",
    "zod": "^4.3.6"
  },
  "bunInstall": {
    "allowScripts": false
  }
}
