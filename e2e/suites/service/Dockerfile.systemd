FROM ubuntu:24.04

# Install systemd and prerequisites
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        systemd \
        systemd-sysv \
        dbus \
        curl \
        sudo \
        git \
        ca-certificates \
        nginx \
    && rm -rf /var/lib/apt/lists/* \
    && systemctl mask \
        dev-hugepages.mount \
        sys-fs-fuse-connections.mount \
        sys-kernel-config.mount \
        sys-kernel-debug.mount \
        display-manager.service \
        getty@.service \
        kmod-static-nodes.service \
        modprobe@.service \
        plymouth-start.service \
        plymouth-read-write.service \
        plymouth-quit.service \
        plymouth-quit-wait.service \
        systemd-binfmt.service \
        systemd-hwdb-update.service \
        systemd-journal-catalog-update.service \
        systemd-networkd-wait-online.service \
        systemd-sysusers.service \
        systemd-tmpfiles-setup-dev.service \
        systemd-udev-trigger.service \
        systemd-udevd.service \
        systemd-update-utmp.service \
        systemd-update-utmp-runlevel.service \
        systemd-vconsole-setup.service

# Non-root user with sudo
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Copy binary
COPY dotts /usr/local/bin/dotts
RUN chmod +x /usr/local/bin/dotts

# Copy test files
COPY --chown=testuser:testuser e2e/suites/service/dotts.ts /home/testuser/service.ts
COPY --chown=testuser:testuser e2e/suites/service/verify.sh /home/testuser/verify.sh
RUN chmod +x /home/testuser/verify.sh

# systemd as PID 1
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
